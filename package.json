{
  "name": "@nondef/ts-oai-pmh",
  "version": "1.0.0",
  "description": "OAI-PMH 2.0 harvester for Node.js",
  "keywords": [
    "crawl",
    "harvesting",
    "metadata",
    "oai-pmh",
    "ts",
    "typescript"
  ],
  "license": "GPL-3.0",
  "author": "Christoph Hoffmann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctot-nondef/ts-oai-pmh.git"
  },
  "bin": {
    "oai-pmh": "dist/bin/oai-pmh.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "bin": "node dist/bin/oai-pmh.js",
    "document": "typedoc src/index.ts",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm test"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/xml2js": "^0.4.14",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1"
}
